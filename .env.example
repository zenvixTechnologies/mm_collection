# Razorpay — domestic (India-only) payments.
# Copy this file to .env.local and fill in your keys from
# Razorpay Dashboard → Account & Settings → API Keys.
#
# Test Mode: keys start with rzp_test_  (no real money is charged)
# Live Mode: keys start with rzp_live_  (swap these in after account approval — no code change needed)
#
# Never commit real keys. RAZORPAY_KEY_SECRET is read only on the server.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
