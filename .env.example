# M&M COLLECTIONS — environment variables
#
# Copy this file to .env.local for development and fill in real values. On Vercel, add the same
# names under Project → Settings → Environment Variables.
#
# Never commit real values. Only NEXT_PUBLIC_ variables reach the browser — never put a secret
# in one. Each integration is validated when first used; the server logs which ones are missing
# at start-up (names only), and endpoints that need a missing integration return HTTP 503.

# ---------- App ----------
# Public base URL, used in emails and redirects. e.g. http://localhost:3000 or https://your-domain.in
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- MongoDB Atlas ----------
# Atlas → Database → Connect → Drivers. Use a dedicated database user with readWrite on this DB only,
# and allow Vercel's egress in Atlas Network Access.
MONGODB_URI=
# Optional: overrides the database name in the URI (e.g. mm-collections-dev / mm-collections).
MONGODB_DB_NAME=
# Optional: connections per serverless instance (default 10).
MONGODB_MAX_POOL_SIZE=

# ---------- Authentication ----------
# Two different random strings of at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---------- Cloudinary (product images) ----------
# Cloudinary Console → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Razorpay — domestic (India-only) payments ----------
# Razorpay Dashboard (Test Mode) → Account & Settings → API Keys → Generate Test Key.
# Test Mode: keys start with rzp_test_ (no real money is charged).
# Live Mode: keys start with rzp_live_ — only after account approval, and only together with
# RAZORPAY_ALLOW_LIVE=true below (live keys are refused without it).
# RAZORPAY_KEY_SECRET is read only on the server. Never use live keys for development or tests.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Account & Settings → Webhooks → the secret you set on the webhook for
# https://<your-domain>/api/v1/payments/razorpay/webhook
# (events: payment.captured, payment.authorized, payment.failed, order.paid).
RAZORPAY_WEBHOOK_SECRET=
# Set to true only when switching to Live Mode keys on purpose. Leave empty for Test Mode.
RAZORPAY_ALLOW_LIVE=

# ---------- Upstash Redis (rate limiting) ----------
# Upstash Console → your Redis database → REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Resend (transactional email) ----------
# Resend → API Keys. EMAIL_FROM must use a domain verified in Resend,
# e.g. "M&M COLLECTIONS <orders@your-domain.in>".
RESEND_API_KEY=
EMAIL_FROM=

# ---------- Vercel Cron ----------
# Random string of at least 16 characters. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
